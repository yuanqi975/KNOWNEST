# Local configuration and tools
.*
!.env.example
!.gitignore
!.dockerignore
!.gitattributes
!.github/

# Secrets
*.pem
*.key
*.crt
*_key
*_secret

# Dependencies and build outputs
node_modules/
dist/
build/
**/__pycache__/
*.py[cod]
*.tsbuildinfo

# Logs and temporary files
*.log
*.pid
*.swp
*.swo
logs/
tmp/
temp/

# Local data; synthetic evaluation fixtures are versioned
*.db
*.db-wal
*.db-shm
data/
output/

# Design assets remain local
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.ico
*.tif
*.tiff
*.avif
*.svg

