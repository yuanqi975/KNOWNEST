# KNOWNEST environment template
DATABASE_URL=postgresql+psycopg://knownest:knownest@localhost:5432/knownest
REDIS_URL=redis://localhost:6379/0

# Context and memory (PostgreSQL + rebuildable Redis cache)
CONTEXT_ENABLED=true
SUMMARIES_ENABLED=true
MEMORY_RECALL_ENABLED=true
MEMORY_EXTRACTION_ENABLED=true
CONTEXT_CACHE_ENABLED=true
CONTEXT_WINDOW_TOKENS=32768
MAX_OUTPUT_TOKENS=4096
MEMORY_EMBEDDING_TIMEOUT_SECONDS=2
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=knownest_vectors
REQUIRE_MILVUS=false
STORAGE_PATH=./data/uploads
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=50
SECRET_KEY=replace-with-a-long-random-secret
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
EMBEDDING_DIMENSION=4096
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=true
